# 依赖
node_modules/

# 构建产物：dist/ 需要入库
# DSH 0.2.0 自带 pnpm 11，会拦截 git 依赖的构建脚本（ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED），
# 且 allowBuilds 的 key 带 commit sha，用户无法预先填写。因此从仓库地址安装不能依赖 prepare，
# dist/ 必须提交进仓库（从 git 安装时 files 字段仍生效，多余源码不会被装进去）。
*.tsbuildinfo

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 由 CI 下载的 aria2 二进制，不入库
packages/aria2-win32-x64/bin/aria2c.exe
packages/aria2-win32-arm64/bin/aria2c.exe
packages/aria2-linux-x64/bin/aria2c
packages/aria2-linux-arm64/bin/aria2c
# CI 临时文件
aria2.zip
aria2-tmp/
aria2-*.zip
aria2-*-tmp/
*.tgz

# 编辑器
.idea/
.vscode/

# pnpm 临时文件
_tmp_*

# lockfile 由 CI 用 pnpm 9 重新生成（本地 pnpm 11 生成的格式不兼容）
pnpm-lock.yaml

# pnpm 11 本机的 build 审批/workspaces 状态文件，不入库
pnpm-workspace.yaml

.npmrc
