{
  "name": "@leisureyu/dsh-smart-dl",
  "version": "1.1.1",
  "description": "Multi-threaded downloader plugin for DeepSeek Harness: bundles aria2, probes file size and picks aria2 multi-connection or curl fallback automatically (Windows x64/arm64, Linux x64/arm64)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeiSureYu/dsh-smart-download.git"
  },
  "homepage": "https://github.com/LeiSureYu/dsh-smart-download#readme",
  "bugs": {
    "url": "https://github.com/LeiSureYu/dsh-smart-download/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "optionalDependencies": {
    "@leisureyu/dsh-aria2-linux-arm64": "1.37.0",
    "@leisureyu/dsh-aria2-linux-x64": "1.37.0",
    "@leisureyu/dsh-aria2-win32-arm64": "1.37.0",
    "@leisureyu/dsh-aria2-win32-x64": "1.37.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <4.0.1-0 || >=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-client.mjs",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check": "pnpm typecheck && pnpm typecheck:test",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "download",
    "downloader",
    "download-manager",
    "download-accelerator",
    "aria2",
    "aria2-downloader",
    "aria2c",
    "multi-thread",
    "multi-threaded-download",
    "multithread",
    "mirror",
    "resume",
    "resumable-download",
    "github-mirror"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
